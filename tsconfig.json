{
    "compilerOptions": {
      "target": "es5",
      "lib": ["dom", "es6"],
      "declaration": true,
      "declarationDir": "dist/types",
      "outDir": "dist",
      "module": "esnext",
      "moduleResolution": "node",
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "importHelpers": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
  }
  